# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML: Smart Merge (UnityYAMLMerge) needs a local git config entry; see CLAUDE.md.
# Without that entry git falls back to its normal text merge.
*.unity             merge=unityyamlmerge linguist-generated
*.prefab            merge=unityyamlmerge linguist-generated
*.asset             merge=unityyamlmerge linguist-generated
*.anim              merge=unityyamlmerge linguist-generated
*.controller        merge=unityyamlmerge linguist-generated
*.overrideController merge=unityyamlmerge linguist-generated
*.mat               merge=unityyamlmerge linguist-generated
*.physicsMaterial2D merge=unityyamlmerge linguist-generated
*.mixer             merge=unityyamlmerge linguist-generated
*.lighting          merge=unityyamlmerge linguist-generated
*.meta              linguist-generated

# Code
*.cs                diff=csharp

# Generated by the Input System; edit the .inputactions source instead
Assets/InputSystem_Actions.cs linguist-generated

# Binary assets (never diff or convert line endings)
*.png               binary
*.jpg               binary
*.jpeg              binary
*.psd               binary
*.aseprite          binary
*.ico               binary
*.ttf               binary
*.otf               binary
*.wav               binary
*.mp3               binary
*.ogg               binary
*.fbx               binary
*.zip               binary
*.pdf               binary
*.dll               binary
*.so                binary
*.exr               binary
*.tga               binary
